# ---- Supabase ----
# Safe for the browser (public project URL + anon key, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in server routes/actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI Provider (Groq) ----
# Ultra-fast LLM inference for chat, document analysis, and modes
GROQ_API_KEY=
# Optional: defaults to "llama-3.3-70b-versatile" or "llama-3.1-8b-instant"
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Speech-to-Text (AssemblyAI) ----
# Powers audio and speech transcription features
ASSEMBLYAI_API_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
